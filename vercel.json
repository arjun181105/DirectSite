{
  "buildCommand": "npm run build:production",
  "outputDirectory": "dist",
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.directsite.com.au"
        }
      ],
      "destination": "https://directsite.com.au/:path*",
      "permanent": true
    },
    {
      "source": "/website-design/",
      "destination": "/web-design/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
